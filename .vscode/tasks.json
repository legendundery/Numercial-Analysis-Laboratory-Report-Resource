{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "cppbuild",
      "label": "C/C++: clang++.exe 生成活动文件",
      "command": "D:\\codetools\\msys64\\mingw64\\bin\\clang++.exe",
      "args": [
        "-fcolor-diagnostics",
        "-fansi-escape-codes",
        "-g",
        "-fexec-charset=UTF-8",
        "-I${workspaceFolder}/include",
        "-std=c++20",
        "${workspaceFolder}/src/main.cpp",
        "${workspaceFolder}/src/ui.cpp",
        "${workspaceFolder}/src/calc.cpp",
        "${workspaceFolder}/src/manager.cpp",
        "-o",
        "${workspaceFolder}/main.exe",
        "-lpdcurses", // libpdcurses.a
        "-lgdi32" // Windows GDI32
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "编译器: D:\\codetools\\msys64\\mingw64\\bin\\clang++.exe"
    }
  ]
}
